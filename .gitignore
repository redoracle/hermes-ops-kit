# Hermes Ops Kit — gitignore

# Secrets
.env
.env.*
*.secret
*.secrets
*.key
*.pem
*.jsonl

# Allow .env.example template (shipped as documentation)
!examples/.env.example

# Python
__pycache__/
.pytest_cache/
*.pyc

# IDE
.vscode/
.idea/

# Stray literal-path artifacts (unexpanded $HOME / ~ from a misconfigured env var)
/$HOME/
/~/
