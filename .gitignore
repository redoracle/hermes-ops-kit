# Hermes Ops Kit — gitignore
.DS_Store

# Secrets
.env
.env.*
*.secret
*.secrets
*.key
*.pem
*.jsonl

# Allow .env.example template (shipped as documentation)
!examples/.env.example

# Python
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# IDE
.vscode/
.idea/

# Local agent/MCP tooling state (never ship: local paths + memory DBs)
.serena/
.headroom/
.mcp.json

# Local operator playbooks (hand-authored, personal — local-only, not shipped)
skills/operator/

# Stray literal-path artifacts (unexpanded $HOME / ~ from a misconfigured env var)
/$HOME/
/~/
_templates
.claude
CLAUDE.md
.local
.ruff_cache
.venv/

docs/ROUND_BALANCING.md
