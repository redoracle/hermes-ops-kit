# Hermes Ops Kit — Bootstrap Environment Template
# Copy to ~/.hermes/.env and fill in your values.
# chmod 600 ~/.hermes/.env

# Secret backend type (currently only "vaultwarden" is supported)
HERMES_SECRET_BACKEND=vaultwarden

# Vaultwarden / Bitwarden server URL (HTTPS required)
VAULTWARDEN_SERVER_URL=https://<your-vaultwarden-host>

# Bootstrap user credentials (used for initial `bw login`)
VAULTWARDEN_USER=<your-email>
VAULTWARDEN_PASSWORD=<your-master-password>

# Authentication mode:
#   bitwarden_cli_password  — user/password from .env
#   bitwarden_cli_api_key   — BW_CLIENTID + BW_CLIENTSECRET
#   bitwarden_cli_session   — existing BW_SESSION token
HERMES_AUTH_MODE=bitwarden_cli_session

# Bitwarden session token (from `bw unlock`)
# Rotate daily — sessions expire periodically.
BW_SESSION=<session-key>

# ─── Provider API Keys (set by `hermes-key-rotate --render-env`) ────────
# These are auto-generated into ~/.hermes/.env.generated from Vaultwarden.
# Do NOT put real keys here. Use Vaultwarden as the canonical secret store.

# Assistant API endpoint (for remote Hermes agent delegation)
# EXAMPLE_ASSISTANT_API_BASE=http://<assistant-host>:8642/v1
# EXAMPLE_ASSISTANT_API_KEY=<assistant-api-key>
# EXAMPLE_ASSISTANT_MODEL=hermes-agent
